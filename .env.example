DART_API_KEY=

# 키움 REST API (https://openapi.kiwoom.com)
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# 1이면 모의투자 서버(mockapi.kiwoom.com)
KIWOOM_MOCK=0

# 리포트 메일 (Gmail SMTP — 일반 비밀번호가 아니라 '앱 비밀번호' 16자리)
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_TO=

# 텔레그램 요약 알림 (실거래 제어 봇 토큰은 쓰지 말 것)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PREFIX=

# 자동 실행(cron)용 Claude Code 장기 토큰 (claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=

# 읽기 전용 REST API (scripts/serve_api.py)
API_TOKEN=
API_PORT=8770
